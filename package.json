{
  "name": "chipforge",
  "private": true,
  "version": "1.0.0",
  "description": "Générateur paramétrique de copeaux d'usinage 3D (OBJ / STEP) pour le rendu.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit": "npm audit --audit-level=low",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "fflate": "0.8.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "occt-import-js": "0.0.23",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
